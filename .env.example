GEMINI_API_KEY=

# Gemini generation model for RAG answers (Milestone 5).
# Separate from gemini-embedding-001 used for embeddings.
# Default: gemini-3.5-flash (verified on Google AI Studio free tier).
GEMINI_CHAT_MODEL=gemini-3.5-flash

# Optional: chat provider selection (gemini only for now).
# CHAT_PROVIDER=gemini

# Tunable starting point for cosine similarity filtering (0-1).
# Not universal — adjust based on your corpus and retrieval quality.
RAG_MIN_SIMILARITY=0.45

# ChromaDB local server (Windows x64: npm run chroma:docker, macOS/Linux: npm run chroma)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_DATA_PATH=./chroma-data

# Optional collection override (default: enterprise-knowledge).
# Integration tests use enterprise-knowledge-integration-test — start dev with:
#   CHROMA_COLLECTION=enterprise-knowledge-integration-test npm run dev
# CHROMA_COLLECTION=enterprise-knowledge
